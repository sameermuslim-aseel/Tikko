# این فایل الگوست — مقدار واقعی را اینجا نگذارید.
# کپی بگیرید به .env.local و آن‌جا پر کنید (.env.local در گیت نیست).
#
#   cp .env.local.example .env.local
#
# مقادیر را از داشبورد سوپابیس بردارید: Settings → API Keys

# آدرس API پروژه — نه آدرس داشبورد
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# کلید publishable (جایگزین anon قدیمی)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# هشدار: کلید secret (sb_secret_...) را هرگز اینجا یا در کد کلاینت نگذارید.

# کلید عمومی VAPID برای نوتیفیکیشن پوش.
# با این دستور ساخته می‌شود: npx web-push generate-vapid-keys
# فقط کلید عمومی اینجا می‌آید؛ کلید خصوصی در secrets سوپابیس.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
